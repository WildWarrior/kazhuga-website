{
  "routes": [
    {
      "route": "/sitemap.xml",
      "serve": "/sitemap-index.html",
      "statusCode": 200,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/api/*",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "rewrite": "/api/function/{rest}"
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/css/*", "/api/*"]
  },
  "cors": {
    "allowedOrigins": ["*"],
    "allowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowedHeaders": ["Content-Type", "Authorization"],
    "maxAgeSeconds": 3600
  }
}